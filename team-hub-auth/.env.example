# Local `dotnet run` (docker-compose.dev.yml → team-hub-dev):
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=auth_db;Username=matsma
# Docker compose prod (auth container → postgres service):
# ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=authdb;Username=matsma
# Must match team-hub-organization Jwt__* values (and Aspire:Jwt in aspire/TeamHub.AppHost/appsettings.Development.json).
Jwt__Key=team-hub-dev-jwt-key-at-least-32-chars
Jwt__Issuer=AuthService
Jwt__Audience=AuthServiceUsers
