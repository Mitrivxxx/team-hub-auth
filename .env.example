# Optional local `dotnet run` outside Aspire.
# Prefer Aspire AppHost for daily dev. Staging Compose uses root .env.staging.
# Copy to .env only if needed; do not commit .env.

Jwt__Key=CHANGE_ME_JWT_KEY_AT_LEAST_32_CHARACTERS_LONG
Jwt__Issuer=AuthService
Jwt__Audience=AuthServiceUsers

# Host Postgres (Aspire or external) — adjust user/password to match your DB
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=auth_db;Username=CHANGE_ME;Password=CHANGE_ME

Redis__ConnectionString=localhost:6379
